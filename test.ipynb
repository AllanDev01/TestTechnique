from llama_cpp import Llama

import json



llm = Llama(model_path="models/qwen2.5-1.5b-instruct-q4_k_m.gguf", n_ctx=4096, verbose=False)

resp = llm.create_chat_completion(messages=[
    {"role": "system", "content": "Tu anlyse des transcription d'appel entre un conseiler et un client.Ton objectif est de faire une synthese de l'échange et définir quelle était le besoin du client "},
    {"role": "user", "content": "Je suis infirmière libérale. Je fais mes tournées avec ma voiture, environ 18 000 kilomètres par an."}],max_tokens=100,temperature=0,)

print(resp ["choices"][0]["message"]["content"])


